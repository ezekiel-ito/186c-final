        <Param val="data_df=pd.DataFrame(data_array,columns=[&quot;trial number&quot;, &quot;correct&quot;,&quot;resp&quot;,&quot;rt&quot;])&amp;#10;&amp;#10;participant='participant'&amp;#10;output_filename=f'responses/Condition {condition}/{expInfo[participant]}_data.csv'&amp;#10;&amp;#10;data_df.to_csv(output_filename)&amp;#10;&amp;#10;hits,n_signal=np.array([0,0,0]),0&amp;#10;false_positives,n_noise=np.array([0,0,0]),0&amp;#10;&amp;#10;for row in data_df.to_dict(orient=&quot;records&quot;):&amp;#10;    resp=row['resp']&amp;#10;    if row['correct']:&amp;#10;        n_signal+=1&amp;#10;        if resp&gt;1:&amp;#10;            hits[0:resp-1]+=1&amp;#10;            &amp;#10;    else:&amp;#10;        n_noise+=1&amp;#10;        if resp&gt;1:&amp;#10;            false_positives[0:resp-1]+=1&amp;#10;            &amp;#10;print(hits, false_positives)&amp;#10;print(n_signal,n_noise)&amp;#10;h=hits/float(n_signal)&amp;#10;f=false_positives/float(n_noise)&amp;#10;Zh=np.array([NormalDist().inv_cdf(x) for x in h])&amp;#10;Zf=np.array([NormalDist().inv_cdf(x) for x in f])&amp;#10;d_prime=Zh-Zf&amp;#10;&amp;#10;output_filename=f'responses/Condition {condition}/{expInfo[participant]}_computations.csv'&amp;#10;&amp;#10;with open(output_filename, &quot;w&quot;) as file:&amp;#10;    print(h, file=file)&amp;#10;    print(f, file=file)&amp;#10;    print(Zh, file=file)&amp;#10;    print(Zf, file=file)&amp;#10;    print(d_prime, file=file)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
