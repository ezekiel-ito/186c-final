        <Param val="if (block_loop.thisN) {&amp;#10;    i = (((block_loop.thisN - 1) * s_perblock) + encoding_loop.thisN);&amp;#10;    sentence_reformatted = sentence_list[s_order[i]];&amp;#10;    if (dev_mode) {&amp;#10;        console.log(sentence_reformatted);&amp;#10;    }&amp;#10;} else {&amp;#10;    sentence_reformatted = practice_sentences[ps_order[encoding_loop.thisN]];&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="&amp;#10;if block_loop.thisN:&amp;#10;    i=(block_loop.thisN-1)*s_perblock+encoding_loop.thisN&amp;#10;    sentence_reformatted=sentence_list[s_order[i]]&amp;#10;    if dev_mode:&amp;#10;        print(sentence_reformatted)&amp;#10;else:&amp;#10;    sentence_reformatted=practice_sentences[ps_order[encoding_loop.thisN]]" valType="extendedCode" updates="constant" name="Begin Routine"/>
